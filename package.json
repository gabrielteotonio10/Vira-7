{
  "name": "vira-7",
  "version": "2.1.0",
  "private": true,
  "description": "Jogo de cartas online de risco e estratégia, baseado nas regras do Flip 7. Frontend em HTML/CSS/JS, API em FastAPI e Supabase.",
  "scripts": {
    "start": "python -m uvicorn app.main:app --app-dir backend --port 8000",
    "test": "node --test \"tests/*.test.js\"",
    "test:db": "node --test \"database/tests/*.test.mjs\"",
    "test:api": "python -m pytest backend"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  }
}
