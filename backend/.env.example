# Vira-7 — variáveis de ambiente do backend
# Copie este arquivo para backend/.env e preencha. O .env NUNCA deve ir para o Git.
#
# Sem SUPABASE_URL a API sobe em "modo de desenvolvimento local": banco em memória e
# login local, só para testar na própria máquina. Para o jogo online de verdade,
# preencha os valores abaixo (Supabase > Project Settings > API).

# URL do projeto. Ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave pública (anon / publishable). Vai para o navegador; o RLS protege os dados.
SUPABASE_ANON_KEY=

# Chave secreta (service_role / secret). SOMENTE no servidor: ela ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Só para projetos que assinam o JWT com o segredo legado (HS256):
# Project Settings > API > JWT Settings > JWT Secret. Projetos novos usam chaves
# assimétricas e a API as busca sozinha; nesse caso deixe em branco.
SUPABASE_JWT_SECRET=

# Usado apenas por scripts/migrate.py para aplicar as migrations.
# Supabase > Connect > "Session pooler" (funciona em redes IPv4).
# Ex.: postgresql://postgres.abcdefghijklmnop:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Origens liberadas para CORS, separadas por vírgula. Deixe vazio quando a própria
# API serve o frontend (mesma origem). Ex.: https://vira7.exemplo.com
CORS_ORIGINS=

# development | production (production exige o Supabase configurado)
APP_ENV=development

# A API serve o frontend em / (true) ou só a API (false).
SERVE_FRONTEND=true

# Árbitro que aplica o tempo de turno e joga por quem desconectou.
REFEREE_ENABLED=true
# Segundos sem sinal do jogador da vez até o servidor jogar por ele.
DISCONNECT_GRACE_SECONDS=40
# Segundos sem sinal de ninguém até a sala ser fechada sozinha (0 = nunca).
STALE_ROOM_SECONDS=180

# Limite de requisições por IP e por usuário (proteção contra abuso).
RATE_LIMIT_ENABLED=true
# Ligue só atrás de um proxy/CDN confiável: o limite passa a usar o IP de X-Forwarded-For.
# Com isso ligado e sem proxy, qualquer cliente poderia forjar o cabeçalho.
TRUST_PROXY=false
